class APKanalyser:
    def __init__(self, apk_directory_path):
        """
        APK Analyser constructor. APK analyser extracts static features from APK files in the given directory.

        Parameters:
        apk_directory_path (Path): Path to the directory containing the APK files to be analysed.

        Raises:
        ValueError: If the provided path is not a directory.
        """
        if apk_directory_path.is_dir():
            self.apk_directory_path = apk_directory_path
        else:
            raise ValueError("Provided path is not a directory.")

        self.apk_list = []  # List to hold APK objects

        self._load_apks()  # Load APKs from the directory

    def _load_apks(self):
        """
        Private Method that constructs APK objects for each APK file and constructs a list of APKs.

        Raises:
        Exception: If an APK file cannot be loaded.
        """
        for apk_path in self.apk_directory_path.glob("*.apk"):
            try:
                apk_obj = APK(str(apk_path))
                self.apk_list.append(apk_obj)
            except Exception as e:
                print(f"Error loading APK {apk_path}: {e}")

    def export_features(self, output_csv):
        # TODO
        """
        (WIP - old)

        Exports the extracted features of all APKs to a CSV file.

        Parameters:
        output_csv (str): Path to the output CSV file.
        """

        with open(output_csv, mode="w", newline="") as csv_file:
            fieldnames = ["apk_name", "package_name", "version_name", "permissions"]
            writer = csv.DictWriter(csv_file, fieldnames=fieldnames)
            writer.writeheader()

            for apk in self.apk_list:
                apk_metadata = apk.get_metadata()
                writer.writerow(
                    {
                        "apk_name": apk_metadata["apk_name"],
                        "package_name": apk_metadata["package_name"],
                        "version_name": apk_metadata["version_name"],
                        "permissions": ", ".join(apk_metadata["permissions"]),
                    }
                )

        print(f"Feature extraction completed. Results saved to {output_csv}.")

    def output_features(self):
        """
        Outputs the extracted features of all APKs to the console.
        """

        for apk in self.apk_list:
            metadata = apk.get_metadata()
            print(f"APK Name: {metadata['apk_name']}")
            print(f"App Name: {metadata['app_name']}")
            print(f"Package Name: {metadata['package_name']}")
            print(f"Version Name: {metadata['version_name']}")
            print(
                f"☢️ Suspicious Permissions: {', '.join(metadata['suspicious_permissions'])}\n"
            )
            print(f"API Calls: {', '.join(metadata['api_calls'])}\n")
            print("-" * 40)


